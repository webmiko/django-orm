# Django
# Copy to .env and set your values. Do not commit .env.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Создайте БД и пользователя — см. README.

DB_NAME=django_orm
DB_USER=django_orm_user
DB_PASSWORD=django_orm_password
DB_HOST=localhost
DB_PORT=5432

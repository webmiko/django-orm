# Django
# Copy to .env and set your values. Do not commit .env.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: PostgreSQL, если задан DB_NAME. Если закомментировать/убрать DB_NAME — SQLite (db.sqlite3).

DB_NAME=django_orm
DB_USER=django_orm_user
DB_PASSWORD=django_orm_password
DB_HOST=localhost
DB_PORT=5432

# Email: SMTP (пароли приложений, не личные пароли аккаунтов).
# Яндекс (SSL 465), Gmail (TLS 587), Mail.ru (TLS 2525) — см. документацию провайдера.
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your_email@yandex.ru
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your_email@yandex.ru

# Redis и кеширование: CACHE_ENABLED=True включает RedisCache; при False — кеш не используется.
CACHE_ENABLED=True
REDIS_URL=redis://127.0.0.1:6379/1

# Запрещённые слова в названии/описании товара (без правки Python):
# по умолчанию читается файл config/forbidden_product_words.txt
# PRODUCT_FORBIDDEN_WORDS_FILE=config/forbidden_product_words.txt
# либо список через запятую, если файла нет: PRODUCT_FORBIDDEN_WORDS=казино,лотерея
